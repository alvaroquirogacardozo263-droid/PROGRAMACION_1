const MAX: usize = 100;

struct Vectores {
    //Atributos
    dimension: usize,
    elemento: [u64;MAX],
}

impl Vectores {
    //Constructor
    fn new() -> Vectores {
        Vectores {
            dimension: 0,
            elemento: [0;MAX],
        }
    }

    fn dim(&self) -> usize {
        self.dimension
    }

    fn dimensionar(&mut self, d:usize) {
        self.dimension = d;
    }

    fn addelement(&mut self, e:u64) {
        if self.dimension < MAX {
            self.elemento[self.dimension] = e;
            self.dimension += 1;
        }
    }

    fn show(&self) {
        for i in 0..self.dimension { //Va hasta el nro - 1
            println!("Elemento[{}] = {}", i, self.elemento[i]);
        }
    }

    fn reemplazar(&mut self, p:usize, e:u64){
        if p <= self.dimension {
            self.elemento[p-1] = e;
        }
    }

    fn insertar(&mut self, p:usize, e:u64){
        if (self.dimension < MAX) && (p <= self.dimension) {
            self.dimension += 1;
            let mut x = self.dimension;
            while x > p-1 {
                self.elemento[x-1] = self.elemento[x-2];
                x -= 1;
            }
            self.elemento[p-1] = e;
        }
    }
        /* Impares a la izquierda y pares a la derecha, ambos ascendentes*/
    fn ordenar_impares_pares(&mut self) {
        let n = self.dimension;
        // La clave (es_par, valor) pone primero los impares y luego los pares
        self.elemento[..n].sort_by_key(|&x| (x % 2 == 0, x));
    }

    // 2.- Ordenar de adentro hacia afuera
    fn ordenar_adentro_afuera(&mut self) {
        let n = self.dimension;
        if n == 0 {
            return;
        }
        self.elemento[..n].sort(); // ascendente

        let ordenado = self.elemento; // copia del arreglo ordenado
        let c = n / 2; // posición central

        self.elemento[c] = ordenado[0]; // el menor va al centro
        for k in 1..n {
            if k % 2 == 1 {
                self.elemento[c - (k + 1) / 2] = ordenado[k]; // izquierda
            } else {
                self.elemento[c + k / 2] = ordenado[k]; // derecha
            }
        }
    }
}

